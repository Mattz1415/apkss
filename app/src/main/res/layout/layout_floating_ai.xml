<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Mode 1: Draggable Matte-Black Monochrome Floating Bubble -->
    <FrameLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="4dp"
        android:background="@drawable/bg_bubble_circle"
        android:clickable="true"
        android:contentDescription="@string/cd_ai_bubble"
        android:elevation="10dp"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivBubbleIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_ai_bubble" />
    </FrameLayout>

    <!-- Mode 2: Architectural Monochrome Dark Panel -->
    <LinearLayout
        android:id="@+id/panelContainer"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Draggable Monochrome Header -->
        <LinearLayout
            android:id="@+id/panelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ai_bubble"
                app:tint="@color/ink_inverse" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/floating_title"
                    android:textColor="@color/ink_inverse"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jetbrains_mono"
                    android:maxLines="1"
                    android:text="@string/default_model_id"
                    android:textColor="@color/ink_inverse_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_tonal"
                android:contentDescription="@string/cd_minimize_panel"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_minimize"
                app:tint="@color/ink_inverse" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_tonal"
                android:contentDescription="@string/cd_close_service"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                app:tint="@color/ink_inverse" />
        </LinearLayout>

        <!-- High-Contrast Pure White CTA: Auto Jawab Layar -->
        <LinearLayout
            android:id="@+id/btnAutoAnswer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_gradient"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_auto_screen"
                app:tint="@color/ink_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/space_grotesk"
                android:text="@string/floating_btn_auto_answer"
                android:textColor="@color/ink_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Monochrome Loading Bar -->
        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ink_inverse" />

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="@string/floating_loading_text"
                android:textColor="@color/ink_inverse_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Scrollable AI Answer Area -->
        <ScrollView
            android:id="@+id/scrollResponse"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_response_box"
            android:fadeScrollbars="false"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:lineSpacingExtra="3dp"
                android:text="@string/floating_placeholder_response"
                android:textColor="@color/ink_inverse"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>

        <!-- Copy & Clear Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_btn_tonal"
                android:clickable="true"
                android:contentDescription="@string/cd_copy_answer"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/ink_inverse" />

                <TextView
                    android:id="@+id/tvCopyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="@string/floating_btn_copy"
                    android:textColor="@color/ink_inverse"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_tonal"
                android:clickable="true"
                android:contentDescription="@string/cd_clear_answer"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clear"
                    app:tint="@color/ink_inverse_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="@string/floating_btn_clear"
                    android:textColor="@color/ink_inverse_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Manual Prompt Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_dark"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="@string/floating_input_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="44dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="@color/ink_inverse"
                android:textColorHint="@color/ink_inverse_muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_send"
                android:contentDescription="@string/cd_send_prompt"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_send"
                app:tint="@color/ink_primary" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
